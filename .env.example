# ==============================================================================
# Zoo Analytics Web Dashboard - Environment Variables Template
# ==============================================================================
# Copy this file to `.env.local` for local development or deployment:
#   cp .env.example .env.local
#
# All variables are optional. Omitting them will disable the corresponding feature
# or run in default local development mode.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dashboard Authentication
# ------------------------------------------------------------------------------
# Shared password required to access dashboard pages and internal APIs.
# - If left empty or omitted: Authentication is disabled (local development mode).
# - Changing this value immediately invalidates all active user sessions (HMAC-keyed).
DASHBOARD_PASSWORD=

# ------------------------------------------------------------------------------
# 2. Event Ingestion Security
# ------------------------------------------------------------------------------
# Secret Bearer token required for `POST /api/events` (used by zoo-monitor edge AI).
# - In zoo-monitor `configs/app_config.yaml`, set: `analytics.api_key: "your-secret-key"`
# - If left empty: Ingestion accepts events without authentication.
INGEST_API_KEY=

# ------------------------------------------------------------------------------
# 3. AI Engine Integration (zoo-monitor FastAPI Server)
# ------------------------------------------------------------------------------
# Base URL of the zoo-monitor AI engine API server (core/api_server.py).
# Enables: /live camera grid, live JPEG frames, and event snapshot images.
AI_ENGINE_URL=http://127.0.0.1:8000

# Optional Bearer token if zoo-monitor api_server has `api_key` configured in app_config.yaml.
AI_ENGINE_API_KEY=

# ------------------------------------------------------------------------------
# 4. MediaMTX Video Playback Server
# ------------------------------------------------------------------------------
# Base URL of MediaMTX's HTTP playback API (configs/mediamtx.yml: playback: yes).
# Enables: 30-second recorded MP4 event clips (15s before to 15s after an event)
# via the "Bukti" (Evidence) modal in event tables.
MEDIAMTX_PLAYBACK_URL=http://127.0.0.1:9996
